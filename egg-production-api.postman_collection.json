{
  "info": {
    "name": "Egg Production API",
    "description": "Run the requests top to bottom with the server running (python app.py). If you set EGG_API_KEY in .env, set the apiKey variable and tick the X-API-Key header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "apiKey",
      "value": "change-me"
    }
  ],
  "item": [
    {
      "name": "1. Log records (4 valid, two sheds)",
      "item": [
        {
          "name": "Shed A - 9 Nov (expect 201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shed\": \"A\",\n  \"date\": \"2026-11-09\",\n  \"count\": 412\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/eggs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eggs"
              ]
            }
          }
        },
        {
          "name": "Shed B - 9 Nov (expect 201)",

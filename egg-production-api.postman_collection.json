    {
      "name": "3. Read records",
      "item": [
        {
          "name": "All records with running totals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/eggs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eggs"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Shed A only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/eggs?shed=A",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eggs"
              ],
              "query": [
                {
                  "key": "shed",
                  "value": "A"
                }
              ]
            }
          }
        },
        {
          "name": "One week",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/eggs?from=2026-11-09&to=2026-11-15",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eggs"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-11-09"
                },
                {
                  "key": "to",
                  "value": "2026-11-15"
                }
              ]
            }
          }
        }
      ]
